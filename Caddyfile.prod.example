# Pendências da Fábrica — exemplo de Caddyfile de produção
# HTTPS automático via Let's Encrypt. Substitua pelo seu domínio.
# Uso: docker compose up -d  (com o serviço caddy habilitado)

pendencias.suaempresa.com.br {
	reverse_proxy app:3000
	encode gzip

	# Segurança básica
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
