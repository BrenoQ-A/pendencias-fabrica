# Pendências da Fábrica — variáveis de ambiente
# Copie para .env e ajuste conforme o ambiente.

# Banco local (desenvolvimento sem Turso)
DATABASE_URL="file:./db/custom.db"

# Turso (produção na nuvem) — preencha para usar o banco remoto
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ---- Login de acesso ao app ----
APP_USUARIO="admin"
APP_SENHA="fabrica2026"          # TROQUE em produção
AUTH_SECRET=""                   # gere com: openssl rand -hex 32
SESSAO_DIAS="7"                  # duração da sessão (login) em dias
