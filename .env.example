# Fallback de emergência de login — vale SOMENTE enquanto a tabela Usuario
# estiver vazia. Depois de criar usuários com `php cli/criar-usuario.php`,
# estas variáveis são ignoradas (os usuários do banco têm precedência).
APP_USUARIO=admin
APP_SENHA=troque-esta-senha

# Duração da sessão em dias (cookie + arquivos de sessão no servidor)
SESSAO_DIAS=7
